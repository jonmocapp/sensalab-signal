# === Adiciones al .env para el loop The Signal (especialista 09) ===
# Pegar al final del .env local (y crear las Variables/Secrets equivalentes en GitHub).

# Base publica donde viven las ediciones web.
# Interina (sin DNS):  https://<org>.github.io/sensalab-signal
# Final (con DNS):     https://signal.sensalab.io
SIGNAL_PUBLIC_BASE=https://signal.sensalab.io

# Opcional: ruta del JSON de edicion si no usas ediciones-signal/next.json
# SIGNAL_EDITION_JSON=C:\ruta\a\mi-edicion.json

# Solo GitHub (no va en .env):
#   Secret  PAGES_DEPLOY_TOKEN  -> fine-grained PAT con contents:read+write SOLO
#                                  sobre el repo publico sensalab-signal
#   Variable SIGNAL_SITE_REPO   -> ej. <org>/sensalab-signal
