# === SensaLab Newsletter Bot — variables de entorno ===
# Copia este archivo a ".env" y llena tus valores. NUNCA subas .env a git.

# --- Claude / Anthropic (OBLIGATORIO para escribir) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8
# Alternativas: claude-sonnet-5 (mas barato) | claude-fable-5 (maxima calidad)
# Costo real ~$0.05-0.08 USD/edicion (~$3-4/ano). NO es gratis: requiere creditos prepagados.

# --- Entrega ---
# file  = solo guarda el HTML (default, 100% gratis, no envia)
# draft = crea BORRADOR en el ESP (tu revisas y envias)
# send  = crea y ENVIA solo
SEND_MODE=file

# Proveedor de envio:
#   brevo      -> plan GRATIS SI envia HTML por API (300/dia). RECOMENDADO.
#   mailerlite -> plan gratis NO envia HTML propio por API (requiere Advanced, de pago).
PROVIDER=brevo

# --- Brevo (si PROVIDER=brevo) ---
BREVO_API_KEY=
BREVO_LIST_ID=

# --- MailerLite (si PROVIDER=mailerlite; recuerda: HTML por API = plan Advanced) ---
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# --- Remitente ---
FROM_NAME=SensaLab
FROM_EMAIL=hello@sensalab.io

# --- Datos legales del pie (CAN-SPAM; evita que el ESP pegue su footer generico) ---
COMPANY_LEGAL_NAME=SensaLab
COMPANY_ADDRESS=Tu direccion fisica, Ciudad, Pais

# --- Ajustes editoriales (opcionales) ---
MAX_STORIES=5
MIN_STORIES=3
LOOKBACK_DAYS=10
MIN_GEO_STORIES=2
